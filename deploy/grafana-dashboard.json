{
  "title": "CineVN Playback Observability",
  "tags": [
    "cinevn",
    "playback"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Time to First Frame (p50)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(playback_time_to_first_frame_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 2,
      "title": "Seek Latency (p95)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(playback_seek_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 3,
      "title": "Playback Success Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "100 * sum(rate(playback_success_total[5m])) / clamp_min(sum(rate(playback_success_total[5m])) + (sum(rate(playback_failure_total[5m])) or vector(0)), 0.000001)",
          "legendFormat": "Success %",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 4,
      "title": "Rebuffer Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(playback_rebuffer_seconds_total[5m])) / clamp_min(sum(rate(playback_played_seconds_total[5m])) + sum(rate(playback_rebuffer_seconds_total[5m])), 0.000001)",
          "legendFormat": "Rebuffer %",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 0.05,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.03
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 5,
      "title": "Resolve Duration by Stage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (stage) (rate(playback_stage_duration_seconds_sum[5m])) / sum by (stage) (rate(playback_stage_duration_seconds_count[5m]))",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 6,
      "title": "Resolve Duration Distribution",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum by (le) (rate(playback_resolve_duration_seconds_bucket[5m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "format": "heatmap"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "calculate": false
      }
    },
    {
      "id": 7,
      "title": "Seek Latency by Method",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (method) (rate(playback_seek_latency_seconds_sum[5m])) / sum by (method) (rate(playback_seek_latency_seconds_count[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 8,
      "title": "Playback Success vs Failure",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(playback_success_total[5m])",
          "legendFormat": "Success",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(playback_failure_total[5m])",
          "legendFormat": "Failure",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "uid": "cinevn-playback",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
