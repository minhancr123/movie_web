label_replace(1 - min(up{job="cinevn",site="lan"}), "check", "backend-down", "", "") or label_replace(absent(up{job="cinevn",site="lan"}), "check", "monitor-missing", "", "") or label_replace((histogram_quantile(0.5,sum by(le)(rate(playback_time_to_first_frame_seconds_bucket{site="lan",schema="latency-v3"}[10m]))) > bool 3) and sum(increase(playback_time_to_first_frame_seconds_count{site="lan",schema="latency-v3"}[10m])) >= 10, "check", "first-frame-slow", "", "") or label_replace((histogram_quantile(0.95,sum by(le)(rate(playback_seek_latency_seconds_bucket{site="lan",schema="latency-v3"}[10m]))) > bool 8) and sum(increase(playback_seek_latency_seconds_count{site="lan",schema="latency-v3"}[10m])) >= 10, "check", "seek-slow", "", "") or label_replace((sum(increase(playback_failure_total{site="lan"}[10m])) / clamp_min(sum(increase(playback_success_total{site="lan"}[10m])) + sum(increase(playback_failure_total{site="lan"}[10m])),1) > bool 0.01) and sum(increase(playback_failure_total{site="lan"}[10m])) >= 3, "check", "playback-failures", "", "") or label_replace((sum(rate(playback_rebuffer_seconds_total{site="lan"}[10m])) / clamp_min(sum(rate(playback_played_seconds_total{site="lan"}[10m])) + sum(rate(playback_rebuffer_seconds_total{site="lan"}[10m])),0.000001) > bool 0.03) and sum(increase(playback_played_seconds_total{site="lan"}[10m])) > 300, "check", "rebuffering", "", "")
