+                .font(.caption).foregroundStyle(.secondary).padding(8)
+        }.background(.black).foregroundStyle(.white)
+            .onAppear {
+                if URL(string: playback.url).map(EmbeddedPlaybackPolicy.allows) != true {
+                    loading = false; failure = "Nguồn nhúng không được hỗ trợ. Vui lòng chọn nguồn khác."
+                }
+            }
+    }
+}
+
+private struct EmbeddedWebPlayer: UIViewRepresentable {
+    let url: URL
+    @Binding var loading: Bool
+    @Binding var failure: String?
+    func makeCoordinator() -> Coordinator { Coordinator(self) }
+    func makeUIView(context: Context) -> WKWebView {
+        let config = WKWebViewConfiguration()
+        config.websiteDataStore = .nonPersistent()
+        config.allowsInlineMediaPlayback = true
+        config.mediaTypesRequiringUserActionForPlayback = []
+        let web = WKWebView(frame: .zero, configuration: config)
+        web.isOpaque = false; web.backgroundColor = .black
+        web.navigationDelegate = context.coordinator; web.uiDelegate = context.coordinator
+        // A fresh provider request, never the authenticated CineVN URLRequest.
+        web.load(URLRequest(url: url, timeoutInterval: 20))
+        context.coordinator.watchdog = Task { @MainActor in
+            try? await Task.sleep(for: .seconds(25))
+            guard !Task.isCancelled, loading else { return }
+            web.stopLoading(); loading = false; failure = "Nguồn nhúng đang phản hồi chậm. Bạn có thể thử lại hoặc chọn nguồn khác."
+        }
+        return web
+    }
+    func updateUIView(_ web: WKWebView, context: Context) {}
+    static func dismantleUIView(_ web: WKWebView, coordinator: Coordinator) {
+        coordinator.watchdog?.cancel(); web.stopLoading(); web.navigationDelegate = nil; web.uiDelegate = nil
+        web.loadHTMLString("", baseURL: nil)
+    }
+    final class Coordinator: NSObject, WKNavigationDelegate, WKUIDelegate {
+        let parent: EmbeddedWebPlayer
+        var watchdog: Task<Void, Never>?
+        init(_ parent: EmbeddedWebPlayer) { self.parent = parent }
+        func webView(_ webView: WKWebView, decidePolicyFor action: WKNavigationAction, decisionHandler: @escaping (WKNavigationActionPolicy) -> Void) {
+            guard let url = action.request.url else { decisionHandler(.cancel); return }
+            if action.targetFrame == nil { decisionHandler(.cancel); return }
+            decisionHandler(EmbeddedPlaybackPolicy.allows(url) || url.absoluteString == "about:blank" ? .allow : .cancel)
+        }
+        func webView(_ webView: WKWebView, decidePolicyFor response: WKNavigationResponse, decisionHandler: @escaping (WKNavigationResponsePolicy) -> Void) {
+            if response.isForMainFrame, let http = response.response as? HTTPURLResponse, http.statusCode >= 400 {
+                watchdog?.cancel(); parent.loading = false
+                parent.failure = http.statusCode == 403 ? "Nhà cung cấp đang chặn truy cập nguồn này. Bạn có thể yêu cầu bản phát khác." : "Nguồn nhúng chưa phản hồi thành công. Bạn có thể thử lại hoặc yêu cầu phim."
+                decisionHandler(.cancel); return
+            }
+            decisionHandler(.allow)
+        }
+        func webViewWebContentProcessDidTerminate(_ webView: WKWebView) {
+            watchdog?.cancel(); parent.loading = false; parent.failure = "Trình phát đã dừng. Vui lòng thử lại."
+        }
+        func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
+            watchdog?.cancel(); parent.loading = false
+        }
+        func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) { failed(error) }
+        func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) { failed(error) }
+        private func failed(_ error: Error) {
+            if (error as NSError).code == NSURLErrorCancelled { return }
+            watchdog?.cancel(); parent.loading = false; parent.failure = "Không mở được nguồn nhúng. Vui lòng thử lại hoặc chọn nguồn khác."
+        }
+        func webView(_ webView: WKWebView, createWebViewWith configuration: WKWebViewConfiguration, for action: WKNavigationAction, windowFeatures: WKWindowFeatures) -> WKWebView? { nil }
+    }
+}
