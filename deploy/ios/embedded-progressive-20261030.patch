+import Foundation
+import AVFoundation
+
+enum NativePlaybackFailurePolicy {
+    static func isDecoderFailure(_ error: Error?, depth: Int = 0) -> Bool {
+        guard let error = error as NSError?, depth < 5 else { return false }
+        if error.domain == AVFoundationErrorDomain && [AVError.Code.decodeFailed.rawValue,
+            AVError.Code.decoderNotFound.rawValue, AVError.Code.fileFormatNotRecognized.rawValue].contains(error.code) { return true }
+        if error.domain == NSOSStatusErrorDomain && error.code == -12909 { return true }
+        return isDecoderFailure(error.userInfo[NSUnderlyingErrorKey] as? Error, depth: depth + 1)
+    }
+    static func identity(_ token: String) -> String {
+        let first = String(token.split(separator: ":").first ?? "").lowercased()
+        return first.range(of: "^[a-f0-9]{40}$", options: .regularExpression) != nil ? first : token
+    }
+    static func codec(_ source: PlaybackSourceItem?) -> String {
+        let text = "\(source?.codec ?? "") \(source?.filename ?? "")"
+        if text.range(of: #"\b(hevc|h\.?265|x265)\b"#, options: .caseInsensitive.union(.regularExpression)) != nil { return "hevc" }
+        if text.range(of: #"\b(avc|h\.?264|x264)\b"#, options: .caseInsensitive.union(.regularExpression)) != nil { return "avc" }
+        return ""
+    }
+    static func fallback(_ sources: [PlaybackSourceItem], failed: Set<String>, current: PlaybackSourceItem?) -> PlaybackSourceItem? {
+        let height = current?.resolution ?? 1080, failedCodec = codec(current)
+        func priority(_ s: PlaybackSourceItem) -> Int {
+            let different = !codec(s).isEmpty && !failedCodec.isEmpty && codec(s) != failedCodec
+            return (s.cached == true ? 100 : 0) + (s.resolution == height ? 50 : (s.resolution ?? 0) > height ? -50 : 0)
+                + (different ? 60 : 0) + (["verified", "likely"].contains(s.directPlay ?? "") ? 20 : 0)
+        }
+        return sources.enumerated().filter { _, s in
+            guard !s.isEmbedded, s.playable != false, let token = s.sourceToken else { return false }
+            return !failed.contains(identity(token))
+        }.sorted { a, b in priority(a.element) == priority(b.element) ? a.offset < b.offset : priority(a.element) > priority(b.element) }.first?.element
+    }
+}
