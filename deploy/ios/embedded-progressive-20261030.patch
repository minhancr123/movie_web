+import Foundation
+
+struct EmbeddedPlayback: Codable, Identifiable {
+    var id: String { sourceToken }
+    let url: String
+    let sourceToken: String
+    let title: String
+    let provider: String
+    let mode: String
+}
+
+enum EmbeddedPlaybackPolicy {
+    static func allows(_ url: URL) -> Bool {
+        guard url.scheme?.lowercased() == "https", url.user == nil, url.password == nil,
+              url.port == nil || url.port == 443, let host = url.host?.lowercased() else { return false }
+        return host.range(of: #"^embed[0-9]+\.streamc\.xyz$"#, options: .regularExpression) != nil
+    }
+    static func isMissingSource(status: Int, code: String?) -> Bool {
+        if code == "CONTENT_NOT_FOUND" { return false }
+        return status == 404 || (status == 422 && code == "NO_COMPATIBLE_SOURCE")
+    }
+}
