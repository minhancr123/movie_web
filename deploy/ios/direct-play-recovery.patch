+    /// One fresh URL attempt, then one remux attempt. Never reload the stale URL.
+    @MainActor
+    private func recoverPlayback(manual: Bool) {
+        guard recoveryTask == nil, !isFarSeeking else { return }
+        if manual { directRefreshAttempted = false; autoFallbackDone = false }
+        let generation = UUID()
+        recoveryGeneration = generation
+        let startAt = max(player.currentTime, pendingSeekAfterLoad ?? 0)
+        let ownedSession = currentSession?.sessionId ?? sessionId
+        recoveryTask = Task { @MainActor in
+            defer {
+                if recoveryGeneration == generation { recoveryTask = nil; isFarSeeking = false; farSeekStatus = nil }
+            }
+            if effectiveDirectPlay, !directRefreshAttempted, let ownedSession {
+                directRefreshAttempted = true
+                isFarSeeking = true
+                farSeekStatus = "Đang lấy lại đường phát…"
+                do {
+                    let fresh = try await APIService.shared.refreshPlaybackURL(sessionId: ownedSession)
+                    guard !Task.isCancelled, recoveryGeneration == generation else { return }
+                    pendingSeekAfterLoad = startAt > 0 ? startAt : nil
+                    player.load(url: fresh, sessionId: ownedSession, directPlay: true,
+                                initialDuration: player.duration, startOffset: 0)
+                    if startAt > 0 { player.holdRestorationTarget(startAt) }
+                    player.loadExternalTracks(type: context.mediaType, tmdbId: context.tmdbId,
+                        season: currentEpisodeInfo?.season ?? context.season,
+                        episode: currentEpisodeInfo?.episode ?? context.episode,
+                        sourceToken: currentSession?.sourceToken ?? context.sourceToken,
+                        sessionId: ownedSession, positionSeconds: startAt, allowEmbedded: false)
+                    return
+                } catch {
+                    guard !Task.isCancelled, recoveryGeneration == generation else { return }
+                }
+                isFarSeeking = false
+            }
+            guard !Task.isCancelled, recoveryGeneration == generation, !autoFallbackDone,
+                  manual || settings.autoFallbackToRemuxOnFailure else { return }
+            autoFallbackDone = true
+            await triggerRemuxFallback()
+        }
+    }
