+    /// Same owned file/session, with the provider URL cache explicitly bypassed.
+    func refreshPlaybackURL(sessionId: String) async throws -> URL {
+        struct Payload: Decodable { let url: String }
+        struct Envelope: Decodable { let success: Bool; let data: Payload? }
+        guard !sessionId.isEmpty else { throw APIError.serverError("Phiên phát không còn hợp lệ.") }
+        var request = URLRequest(url: URL(string: "\(baseURL)/playback/session/\(sessionId)/refresh")!)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 8
+        if let token = accessToken { request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization") }
+        let (data, response) = try await session.data(for: request)
+        try Task.checkCancellation()
+        guard let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode),
+              let envelope = try? JSONDecoder().decode(Envelope.self, from: data), envelope.success,
+              let value = envelope.data?.url, let url = URL(string: value), url.scheme == "https" else {
+            throw APIError.serverError("Chưa cấp lại được đường phát. Đang thử cách phát khác.")
+        }
+        return url
+    }
