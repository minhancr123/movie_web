--- /dev/null
+++ b/CineVN-IOS/Services/PlaybackProgressEvidence.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+/// A seek-completion/time jump is not evidence that media is playing.
+/// Require several normal clock advances with AVPlayer actually playing.
+struct PlaybackProgressEvidence {
+    private var previous: (clock: Double, wall: Double)?
+    private var consecutive = 0
+    private var lastAdvance = -Double.infinity
+    private var stable = false
+
+    mutating func reset() { self = Self() }
+
+    mutating func observe(clock: Double, wall: Double, rate: Double, playing: Bool,
+                          blocked: Bool, target: Double?) -> Bool {
+        guard clock.isFinite, wall.isFinite, !blocked,
+              target.map({ abs(clock - $0) <= 2 }) ?? true else { reset(); return false }
+        let old = previous
+        previous = (clock, wall)
+        let elapsed = old.map { wall - $0.wall } ?? 0
+        let delta = old.map { clock - $0.clock } ?? 0
+        let advancing = playing && rate > 0 && elapsed > 0 && elapsed <= 2
+            && delta > 0.01 && delta <= max(0.75, elapsed * rate * 2)
+        if advancing {
+            consecutive += 1; lastAdvance = wall
+            if consecutive >= 3 { stable = true }
+        } else {
+            consecutive = 0
+            if wall - lastAdvance > 0.75 { stable = false }
+        }
+        return stable
+    }
+}
