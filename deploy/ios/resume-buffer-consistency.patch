+    private func refreshBufferState(for item: AVPlayerItem) {
+        guard player?.currentItem === item else { return }
+        bufferStateWork?.cancel()
+        guard let player else { return }
+        if player.timeControlStatus == .playing || item.status == .failed {
+            isBuffering = false
+            return
+        }
+        let waiting = item.status == .unknown || player.timeControlStatus == .waitingToPlayAtSpecifiedRate
+            || (isPlaying && item.isPlaybackBufferEmpty)
+        guard waiting else {
+            isBuffering = false
+            return
+        }
+        let work = DispatchWorkItem { [weak self, weak item] in
+            guard let self, let item, self.player?.currentItem === item,
+                  self.player?.timeControlStatus != .playing else { return }
+            self.isBuffering = true
+        }
+        bufferStateWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.45, execute: work)
+    }
