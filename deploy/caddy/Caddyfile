www.cinevn.me {
	redir https://cinevn.me{uri} permanent
}

# Deploy cutovers recreate containers, and for seconds at a time there is no
# upstream behind a route. Without retries every one of those requests is a
# 502 the viewer sees — session polls, heartbeats, auth refreshes — and the
# player treats them as real failures and rebuilds its pipeline. So every
# upstream retries inside a window that covers a recreate.
#
# Safe for POST /resolve too: a retried resolve that already spawned only
# creates a second session, and the server supersedes and reaps those by
# design (RESOLVE_SUPERSEDED, supersede timers, janitor). Caddy never retries
# once response bytes have started flowing, so streams cannot be duplicated
# mid-body.
#
# Snippets live at the top level: defined inside a site block, `import` reads
# the name as a filename instead.
(retry_upstream) {
	lb_retries 3
	lb_try_duration 25s
	lb_try_interval 2s
}

cinevn.me {
	encode zstd gzip
	header -Server

	# Access log, for telling crawlers apart (Googlebot vs junk bots) the next
	# time traffic spikes. Query strings carry playback tokens
	# (?access_token=, ?media_grant=), so they are deleted before the line is
	# written — logs must never become a token store.
	#
	# To a self-rotating file: this box's journal never receives Caddy's
	# stdout (verified empty after a valid, reloaded config), and a failed
	# experiment proved the point the other way — a root-owned access.log
	# makes the reload fail because the caddy user cannot open it. So: the
	# file must be owned by caddy (created by the daemon on first write,
	# never by a root-run validate), and it stays out of git.
	# Gotcha: `sudo caddy validate` itself creates the file as root — always
	# rm -f it after validating and before reloading.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete access_token
					delete media_grant
				}
			}
		}
	}

	route {
		@diagnostic path /api/local-playback-diagnostic /api/local-playback-diagnostic/*
		respond @diagnostic 404

		# These five routes belong to Express backend, not to NextAuth.
		@backendAuth path_regexp auth ^/api/auth/(register|login|google-login|me|profile)/?$
		reverse_proxy @backendAuth 127.0.0.1:5001 {
			import retry_upstream
		}

		# Keep NextAuth providers, csrf, session, callbacks and signout in Next.js.
		@nextAuth path /api/auth /api/auth/*
		reverse_proxy @nextAuth 127.0.0.1:3000 {
			import retry_upstream
		}

		@health path /healthz /health /metrics
		reverse_proxy @health 127.0.0.1:5001 {
			import retry_upstream
		}

		@playback path /api/playback/*
		reverse_proxy @playback 127.0.0.1:5001 {
			flush_interval -1
			import retry_upstream
		}

		@api path /api/* /socket.io /socket.io/*
		reverse_proxy @api 127.0.0.1:5001 {
			import retry_upstream
		}

		# Frontend Next.js default fallback
		reverse_proxy 127.0.0.1:3000 {
			import retry_upstream
		}
	}
}

