{
  "name": "movie-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "test": "node --test tests/dev-cache-reset.test.mjs tests/audio-enhancer.test.mjs tests/ambilight.test.mjs tests/autoplay.test.mjs tests/intro-route-scope.test.mjs tests/playback-progress.test.mjs tests/api-base.test.mjs tests/episode-list.test.mjs tests/fullscreen-ambilight.test.mjs tests/source-preferences.test.mjs",
    "test:routes": "node --test tests/continue-watching-route.test.mjs",
    "test:dev-cache": "node --test tests/dev-cache-reset.test.mjs",
    "test:e2e": "playwright test --browser chromium",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@sentry/react": "^11.0.0",
    "axios": "^1.13.5",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.330.0",
    "next": "16.3.6",
    "next-auth": "^4.24.13",
    "next-pwa": "^5.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-player": "^3.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/hls.js": "^0.13.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
