# Pinned here so every install behaves identically: local dev, CI, and Docker.
# lucide-react@0.330.0 declares peer react ^16.5.1 || ^17 || ^18 while this
# app runs React 19, so a strict `npm ci` fails with ERESOLVE. The pair works
# fine at runtime (icons are pure components), and the Dockerfile has been
# installing with --legacy-peer-deps all along — this file just makes that
# the default instead of a flag callers must remember.
legacy-peer-deps=true
