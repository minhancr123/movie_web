PORT=your-port-here
MONGODB_URI=mongodb://localhost:27017/movieweb
REDIS_URL=redis://localhost:6379
REDIS_HOST=your-redis-host-here
REDIS_PORT=your-redis-port-here
JWT_SECRET=your-jwt-secret-here
GOOGLE_CLIENT_ID=your-google-client-id-here
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_TOKEN=your_tmdb_read_token_here
# Đặt khi mạng chạy backend chặn api.themoviedb.org theo SNI (xem scripts/tmdb-proxy-worker.js).
# Bỏ trống nếu backend chạy ở VPS ngoài VN.
TMDB_BASE_URL=
TMDB_PROXY_TOKEN=
CATALOG_PROVIDER=your-catalog-provider-here
PLAYBACK_PROVIDER=your-playback-provider-here
TORBOX_API_KEY=your-torbox-api-key-here
# Per-user TorBox keys are encrypted per row (services/security/tokenVault.js).
# Sinh khoá bằng: node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
# Stremio-protocol addons, comma-separated (never proxied raw to browsers).
STREMIO_ADDONS=
# Subtitle-protocol addons. The default official OpenSubtitles addon is used
# when this is omitted; set a comma-separated list to override it.
STREMIO_SUBTITLE_ADDONS=https://opensubtitles-v3.strem.io
TORBOX_BASE_URL=your-torbox-base-url-here
TRANSCODE_ROOT=your-transcode-root-here
# Cache HLS local: tối đa 25 GB, giữ bản hoàn tất 2 giờ, dừng remux không
# có lượt đọc segment trong 10 phút và quét dọn mỗi 60 giây.
TRANSCODE_CACHE_MAX_GB=25
TRANSCODE_CACHE_TTL_HOURS=2
TRANSCODE_LIVE_IDLE_MINUTES=10
TRANSCODE_INCOMPLETE_GRACE_MINUTES=10
TRANSCODE_CLEANUP_INTERVAL_SECONDS=60
TRANSCODE_VIEWER_GRACE_SECONDS=120
FFMPEG_BIN=your-ffmpeg-bin-here
FFPROBE_BIN=your-ffprobe-bin-here

# OpenSubtitles REST API. Search is unlimited and gives moviehash matching
# (whether a subtitle was timed for the exact file being played); /download is
# capped at 5/day on an API key alone, so downloads must stay cached.
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
OPENSUBTITLES_USER_AGENT=your-opensubtitles-user-agent-here
