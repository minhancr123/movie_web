# Node.js Backend

# Dependencies
node_modules/

# Environment Variables (SENSITIVE - NEVER COMMIT)
.env
.env.local
.env.production
.env.development
*.env

# BUT keep example files
!.env.example
!.env.production.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*

# Build
dist/
build/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# Misc
*.tmp
.cache/

# Transcode cache. One 4K film lands here as ~17 GB of fMP4 segments, and the
# whole tree is regenerable: `*.tmp` above matches files with that extension,
# not this directory, so without this rule `git add .` stages the lot.
tmp/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
