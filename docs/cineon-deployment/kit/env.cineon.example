# Copy to /opt/cineon/.env.cineon and chmod 600. Never commit the real file.
# Compose consumes this file, not Bash. Quote values containing a literal $.
MONGODB_URI='mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@CLUSTER/movieweb?retryWrites=true&w=majority'
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
NEXTAUTH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
# Numeric version, not v1. Keep this key stable across deployments/backups.
TOKEN_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_OF_32_BYTES
TMDB_READ_TOKEN=
TMDB_API_KEY=
TORBOX_API_KEY=
STREMIO_ADDONS=
STREMIO_SUBTITLE_ADDONS=https://opensubtitles-v3.strem.io
OPENSUBTITLES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRANSCODE_CACHE_MAX_GB=3
RENDITIONS_MAX_GB=3
REMUX_MAX_WRITERS=1
