# Bien moi truong cho docker-compose.prod.yml
#   cp .env.prod.example .env    (dat canh docker-compose.prod.yml)
# File .env nay chua secret — dung commit, dung chup man hinh.

# --- Domain ---
CORS_ORIGIN=https://phim.vidu.com
FRONTEND_URL=https://phim.vidu.com

# --- Database ---
MONGODB_URI=mongodb+srv://...

# --- Auth ---
# openssl rand -base64 48
JWT_SECRET=

# --- Catalog (TMDB) ---
TMDB_API_KEY=
TMDB_READ_TOKEN=

# --- Nguon phat ---
TORBOX_API_KEY=
# Khoa boc cho API key cua tung nguoi dung, luu trong Mongo.
# openssl rand -base64 32   -> dat dang v1:<khoa>
TOKEN_ENCRYPTION_KEYS=
STREMIO_ADDONS=
STREMIO_SUBTITLE_ADDONS=https://opensubtitles-v3.strem.io
OPENSUBTITLES_API_KEY=

# --- Dung luong dia (GB). Tong hai so nay phai NHO HON dia that. ---
TRANSCODE_CACHE_MAX_GB=60
RENDITIONS_MAX_GB=60

# --- Tai ---
# never = tu choi nguon client khong giai ma duoc, thay vi transcode bang CPU.
VIDEO_TRANSCODE_FALLBACK=never
# So luong dung MOI cung luc. Nguoi ghep vao phien dang chay khong ton suat.
REMUX_MAX_WRITERS=3
# 1 khi dung sau Caddy/nginx.
TRUST_PROXY=1
